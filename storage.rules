rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // APK files - anyone can download (for app distribution)
    match /builds/{buildId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User uploads (icons, splash screens)
    match /uploads/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
